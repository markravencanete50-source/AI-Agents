NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional, server-only integrations. Never prefix these with NEXT_PUBLIC_.
MAKE_WEBHOOK_URL=
MAKE_SIGNING_SECRET=
MAKE_EXECUTOR_TOKEN=
MAKE_CALLBACK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Use otp only after the Supabase confirmation and magic-link templates include {{ .Token }}.
NEXT_PUBLIC_AUTH_EMAIL_MODE=link
